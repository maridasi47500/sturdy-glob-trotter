<%= form_with(model: vid) do |form| %>
  <% if vid.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(vid.errors.count, "error") %> prohibited this vid from being saved:</h2>

      <ul>
        <% vid.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.hidden_field :user_id %>
  </div>

  <div>
    <%= form.label :city_id, style: "display: block" %>
    <%= form.select :city_id, City.all.collect {|h|[h.name, h.id]} %>
  </div>

  <div>
    <%= form.label :device_id, style: "display: block" %>
    <%= form.select :device_id, Device.all.collect {|h|[h.name, h.id]} %>
  </div>

  <div>
    <%= form.label :activity_id, style: "display: block" %>
    <%= form.select :activity_id, Activity.all.collect {|h|[h.name, h.id]} %>
  </div>

  <div>
    <%= form.label :myvid, style: "display: block" %>
    <%= form.file_field :myvid %>
  </div>

  <div>
    <%= form.label :content, style: "display: block" %>
    <%= form.text_area :content %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
